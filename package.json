{
  "name": "authkit-clean-arch",
  "version": "1.0.0",
  "private": true,
  "description": "Production-oriented authentication API demonstrating Clean Architecture, TDD, OAuth, refresh-token rotation, PostgreSQL, S3 and CI/CD",
  "type": "commonjs",
  "scripts": {
    "start": "node -r dotenv/config dist/main",
    "dev": "node --watch --inspect=0.0.0.0:9229 -r ts-node/register/transpile-only -r tsconfig-paths/register -r dotenv/config src/main/index.ts",
    "build": "rimraf dist && tsc -p tsconfig-build.json && tsc-alias -p tsconfig-build.json",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --passWithNoTests --no-cache --runInBand",
    "test:watch": "npm test -- --watch",
    "test:staged": "npm test -- --findRelatedTests",
    "test:coverage": "npm test -- --coverage",
    "test:e2e": "jest --config jest.e2e.config.js --passWithNoTests --no-cache --runInBand",
    "test:pg": "jest --config jest.pg.config.js --passWithNoTests --no-cache --runInBand",
    "test:integration": "node -r dotenv/config node_modules/.bin/jest --passWithNoTests --no-cache --runInBand -c ./jest.integration.config.js",
    "test:fb-api": "npm run test:integration -- ./tests/external/facebook-api.test.ts",
    "test:s3": "npm run test:integration -- ./tests/external/aws-s3-file-storage.test.ts",
    "test:api": "node scripts/api-collection-test.js",
    "typeorm": "node -r ts-node/register/transpile-only -r tsconfig-paths/register -r dotenv/config node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate -d src/main/config/data-source.ts",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "npm run typeorm -- migration:run -d src/main/config/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/main/config/data-source.ts",
    "migration:check": "npm run typeorm -- migration:generate src/infra/repos/postgres/migrations/Drift --check -d src/main/config/data-source.ts",
    "migration:run:prod": "typeorm migration:run -d dist/main/config/data-source.js",
    "db:seed": "node scripts/db-seed.js",
    "db:purge-refresh-tokens": "node dist/main/jobs/purge-expired-refresh-tokens.js",
    "outbox:process": "node dist/main/jobs/process-outbox-events.js",
    "prepare": "husky || true",
    "check": "ncu",
    "update": "ncu -u"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "clean-architecture",
    "tdd",
    "oauth",
    "jwt",
    "postgresql",
    "authentication"
  ],
  "author": "Luiz Curti",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest-mock/express": "^3.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-mock-extended": "^4.0.1",
    "lint-staged": "^17.6.0",
    "mockdate": "^3.0.5",
    "npm-check-updates": "^23.1.0",
    "pg-mem": "^3.0.14",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.7",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@prometheus-io/client": "^0.16.1",
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.1",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "jest --passWithNoTests --findRelatedTests"
    ]
  },
  "overrides": {
    "qs": "^6.16.0",
    "test-exclude": "^8.0.0"
  }
}
