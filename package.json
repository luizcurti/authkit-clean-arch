{
  "name": "authkit-clean-arch",
  "version": "1.0.0",
  "description": "Production-oriented authentication API demonstrating Clean Architecture, TDD, OAuth, refresh-token rotation, PostgreSQL, S3 and CI/CD",
  "type": "commonjs",
  "scripts": {
    "start": "node -r dotenv/config dist/main",
    "start:dev": "concurrently \"npm run build:watch\" \"npm run serve:dev\"",
    "serve:dev": "nodemon --delay 1 -r dotenv/config --inspect=0.0.0.0:9229 dist/main/index.js",
    "build": "rimraf dist && tsc -p tsconfig-build.json",
    "build:watch": "tsc -p tsconfig-build.json --watch",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "test": "jest --passWithNoTests --no-cache --runInBand",
    "test:watch": "npm test -- --watch",
    "test:staged": "npm test -- --findRelatedTests",
    "test:coverage": "npm test -- --coverage",
    "test:integration": "node -r dotenv/config node_modules/.bin/jest --passWithNoTests --no-cache --runInBand -c ./jest.integration.config.js",
    "test:fb-api": "npm run test:integration -- ./tests/external/facebook-api.test.ts",
    "test:s3": "npm run test:integration -- ./tests/external/aws-s3-file-storage.test.ts",
    "test:e2e": "jest --config jest.e2e.config.js --passWithNoTests --no-cache --runInBand",
    "test:api": "node scripts/api-collection-test.js",
    "dev": "TS_NODE_DEV=true tsx watch --inspect=0.0.0.0:9229 -r dotenv/config src/main",
    "typecheck": "tsc --noEmit -p tsconfig-build.json",
    "migration:generate": "TS_NODE_DEV=true typeorm-ts-node-commonjs migration:generate -d src/main/config/data-source.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "TS_NODE_DEV=true typeorm-ts-node-commonjs migration:run -d src/main/config/data-source.ts",
    "migration:revert": "TS_NODE_DEV=true typeorm-ts-node-commonjs migration:revert -d src/main/config/data-source.ts",
    "migration:run:prod": "typeorm migration:run -d dist/main/config/data-source.js",
    "db:seed": "node scripts/db-seed.js",
    "prepare": "husky || true",
    "check": "ncu",
    "update": "ncu -u"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "clean-architecture",
    "tdd",
    "oauth",
    "jwt",
    "postgresql",
    "authentication"
  ],
  "author": "Luiz Curti",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest-mock/express": "^2.1.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/module-alias": "^2.0.4",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "concurrently": "^9.2.4",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-mock-extended": "^4.0.1",
    "lint-staged": "^15.5.2",
    "mockdate": "^3.0.5",
    "nodemon": "^3.1.14",
    "npm-check-updates": "^17.1.18",
    "pg-mem": "^2.9.1",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.3.4",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.1",
    "uuid": "^11.1.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.25.76"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "jest --passWithNoTests --findRelatedTests"
    ]
  },
  "overrides": {
    "qs": "^6.16.0",
    "test-exclude": "^8.0.0"
  }
}
