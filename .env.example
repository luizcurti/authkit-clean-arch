# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=nodejs_tdd_db

# -----------------------------------------------------------------------------
# Facebook API Configuration [OBRIGATÓRIA EM PRODUÇÃO]
# -----------------------------------------------------------------------------
# Como obter:
# 1. Acesse https://developers.facebook.com/
# 2. Crie um novo app ou use um existente
# 3. Vá em Settings > Basic
# 4. Copie o App ID e App Secret
#
FB_CLIENT_ID=your_facebook_app_id_here
FB_CLIENT_SECRET=your_facebook_app_secret_here

# -----------------------------------------------------------------------------
# JWT Configuration [OBRIGATÓRIA EM PRODUÇÃO]
# -----------------------------------------------------------------------------
# ATENÇÃO: Use um segredo forte com no mínimo 32 caracteres!
# Gere um seguro com: openssl rand -base64 32
#
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_chars_required_change_this

# -----------------------------------------------------------------------------
# AWS S3 Configuration [OPCIONAL]
# -----------------------------------------------------------------------------
# Necessário apenas se você usar upload de imagens para S3
# Como obter:
# 1. Acesse AWS Console > IAM
# 2. Crie um usuário com permissões S3
# 3. Gere Access Key ID e Secret Access Key
#
S3_ACCESS_KEY_ID=your_aws_access_key_id
S3_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET=your_s3_bucket_name

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
PORT=8080
NODE_ENV=development  # Options: development | production | test
# -----------------------------------------------------------------------------
# Logging Configuration [OPCIONAL]
# -----------------------------------------------------------------------------
# Habilitar logs em arquivo mesmo em desenvolvimento (padrão: apenas em produção)
# ENABLE_FILE_LOGS=true

# Nível de log (padrão: debug em dev, info em prod)
# Options: error | warn | info | http | debug
# LOG_LEVEL=debug
