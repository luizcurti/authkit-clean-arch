# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=authkit_db

# --- Facebook [required in production] ---
# App ID and App Secret from https://developers.facebook.com/ (Settings > Basic)
FB_CLIENT_ID=your_facebook_app_id_here
FB_CLIENT_SECRET=your_facebook_app_secret_here
# Short-lived test-user token for `npm run test:fb-api`; skipped when unset
# FB_TEST_USER_TOKEN=

# --- JWT [required in production] ---
# At least 32 characters: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_chars_required_change_this
# JWT_ISSUER=authkit-clean-arch
# JWT_AUDIENCE=authkit-clean-arch-api

# --- S3 [required in production] ---
# Values target S3Mock. For AWS: unset S3_ENDPOINT and S3_FORCE_PATH_STYLE, use credentials allowed
# s3:PutObject, s3:GetObject and s3:DeleteObject, and the bucket's region
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
S3_BUCKET=authkit-pictures
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9090
S3_FORCE_PATH_STYLE=true
# Base URL pictures are served from (CloudFront). Unset: pre-signed URLs valid for 1 hour
S3_PUBLIC_BASE_URL=http://localhost:9090/authkit-pictures

# --- Application ---
PORT=8080
NODE_ENV=development  # development | production | test

# --- Optional ---
# Comma-separated allowlist. Empty: none in production, all elsewhere
# CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com

# Bearer token (16+ chars) for /api/metrics and /api/health/detailed. Unset: 404 in production
# OPS_TOKEN=

# Reverse-proxy hops whose X-Forwarded-For is trusted (1 behind one load balancer)
# TRUST_PROXY_HOPS=0

# Requests per minute per client: every route / login, refresh and logout together
# RATE_LIMIT_PER_MINUTE=100
# AUTH_RATE_LIMIT_PER_MINUTE=10

# Swagger UI at /api-docs. Default: off in production
# API_DOCS_ENABLED=true

# In-process jobs; 0 disables them (run `npm run db:purge-refresh-tokens` / `npm run outbox:process` instead)
# REFRESH_TOKEN_PURGE_INTERVAL_MINUTES=60
# OUTBOX_POLL_INTERVAL_SECONDS=10

# error | warn | info | http | debug. Default: debug in development, info otherwise
# LOG_LEVEL=debug
