# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=nodejs_tdd_db

# -----------------------------------------------------------------------------
# Facebook API Configuration [REQUIRED IN PRODUCTION]
# -----------------------------------------------------------------------------
# How to get:
# 1. Go to https://developers.facebook.com/
# 2. Create a new app or use an existing one
# 3. Navigate to Settings > Basic
# 4. Copy the App ID and App Secret
#
FB_CLIENT_ID=your_facebook_app_id_here
FB_CLIENT_SECRET=your_facebook_app_secret_here

# -----------------------------------------------------------------------------
# JWT Configuration [REQUIRED IN PRODUCTION]
# -----------------------------------------------------------------------------
# IMPORTANT: Use a strong secret with at least 32 characters!
# Generate a safe one with: openssl rand -base64 32
#
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_chars_required_change_this

# -----------------------------------------------------------------------------
# AWS S3 Configuration [OPTIONAL]
# -----------------------------------------------------------------------------
# Only required if you store images in S3
# How to get:
# 1. Open AWS Console > IAM
# 2. Create a user with S3 permissions
# 3. Generate an Access Key ID and Secret Access Key
#
S3_ACCESS_KEY_ID=your_aws_access_key_id
S3_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET=your_s3_bucket_name

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
PORT=8080
NODE_ENV=development  # Options: development | production | test
# -----------------------------------------------------------------------------
# Logging Configuration [OPTIONAL]
# -----------------------------------------------------------------------------
# Enable file logs even in development (default: only in production)
# ENABLE_FILE_LOGS=true

# Log level (default: debug in dev, info in prod)
# Options: error | warn | info | http | debug
# LOG_LEVEL=debug
