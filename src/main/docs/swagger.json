{
  "openapi": "3.0.0",
  "info": {
    "title": "Advanced TDD Clean Architecture API",
    "description": "REST API built with Clean Architecture, TDD and SOLID principles",
    "version": "1.0.0",
    "contact": {
      "name": "API Support",
      "email": "support@example.com"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080/api",
      "description": "Development server"
    },
    {
      "url": "https://api.example.com/api",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Authentication endpoints"
    },
    {
      "name": "User",
      "description": "User endpoints"
    },
    {
      "name": "Health",
      "description": "Health check endpoints"
    }
  ],
  "paths": {
    "/login/facebook": {
      "post": {
        "tags": ["Authentication"],
  "summary": "Login with Facebook",
  "description": "Authenticate user using Facebook OAuth token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FacebookLoginRequest"
              },
              "example": {
                "token": "EAABwzLixnjYBO..."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successfully executed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FacebookLoginResponse"
                },
                "example": {
                  "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                }
              }
            }
          },
          "400": {
            "description": "Invalid or missing token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "ValidationError",
                  "message": "The field token is required"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unauthorized"
                }
              }
            }
          }
        }
      }
    },
    "/users/picture": {
      "put": {
        "tags": ["User"],
  "summary": "Update profile picture",
  "description": "Upload user's profile picture (PNG or JPG, max 5MB)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "picture": {
                    "type": "string",
                    "format": "binary",
                    "description": "Image file (PNG or JPG)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Picture updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavePictureResponse"
                },
                "example": {
                  "pictureUrl": "https://bucket.s3.amazonaws.com/user-123.jpg",
                  "initials": "JD"
                }
              }
            }
          },
          "400": {
            "description": "Invalid file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "ValidationError",
                  "message": "Invalid file type. Allowed: png, jpg"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unauthorized"
                }
              }
            }
          },
          "413": {
            "description": "File too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "ValidationError",
                  "message": "File size exceeds 5MB limit"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["User"],
  "summary": "Remove profile picture",
  "description": "Removes user's profile picture and returns initials",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Picture removed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavePictureResponse"
                },
                "example": {
                  "initials": "JD"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["Health"],
  "summary": "Basic health check",
  "description": "Checks basic application status",
        "responses": {
          "200": {
            "description": "Application is running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthCheckResponse"
                },
                "example": {
                  "status": "ok",
                  "timestamp": "2025-11-10T22:00:00.000Z",
                  "uptime": 3600,
                  "environment": "production",
                  "version": "1.0.0",
                  "memory": {
                    "used": 45.23,
                    "total": 128.5
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health/detailed": {
      "get": {
        "tags": ["Health"],
  "summary": "Detailed health check",
  "description": "Checks detailed status including database, memory and system",
        "responses": {
          "200": {
            "description": "Detailed application status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdvancedHealthCheckResponse"
                },
                "example": {
                  "status": "healthy",
                  "timestamp": "2025-11-10T22:00:00.000Z",
                  "uptime": 3600,
                  "environment": "production",
                  "version": "1.0.0",
                  "checks": {
                    "database": {
                      "status": "up",
                      "responseTime": 15
                    },
                    "memory": {
                      "status": "normal",
                      "used": 45.23,
                      "total": 128.5,
                      "percentage": 35
                    },
                    "system": {
                      "platform": "linux",
                      "nodeVersion": "v20.10.0",
                      "processId": 1234
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token obtained from login endpoint"
      }
    },
    "schemas": {
      "FacebookLoginRequest": {
        "type": "object",
        "required": ["token"],
        "properties": {
          "token": {
            "type": "string",
            "description": "Facebook OAuth access token",
            "example": "EAABwzLixnjYBO..."
          }
        }
      },
      "FacebookLoginResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT token for API authentication",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        }
      },
      "SavePictureResponse": {
        "type": "object",
        "properties": {
          "pictureUrl": {
            "type": "string",
            "description": "Picture URL in S3",
            "example": "https://bucket.s3.amazonaws.com/user-123.jpg"
          },
          "initials": {
            "type": "string",
            "description": "User initials (when there is no picture)",
            "example": "JD"
          }
        }
      },
      "HealthCheckResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"],
            "description": "Application status"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Health check timestamp"
          },
          "uptime": {
            "type": "number",
            "description": "Uptime in seconds"
          },
          "environment": {
            "type": "string",
            "description": "Environment (development, production, etc)"
          },
          "version": {
            "type": "string",
            "description": "Application version"
          },
          "memory": {
            "type": "object",
            "properties": {
              "used": {
                "type": "number",
                "description": "Memory used in MB"
              },
              "total": {
                "type": "number",
                "description": "Total memory in MB"
              }
            }
          }
        }
      },
      "AdvancedHealthCheckResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["healthy", "degraded", "unhealthy"],
            "description": "Status geral da aplicação"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "uptime": {
            "type": "number"
          },
          "environment": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["up", "down"]
                  },
                  "responseTime": {
                    "type": "number",
                    "description": "Response time in ms"
                  },
                  "error": {
                    "type": "string",
                    "description": "Error message (if down)"
                  }
                }
              },
              "memory": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["normal", "warning", "critical"]
                  },
                  "used": {
                    "type": "number"
                  },
                  "total": {
                    "type": "number"
                  },
                  "percentage": {
                    "type": "number"
                  }
                }
              },
              "system": {
                "type": "object",
                "properties": {
                  "platform": {
                    "type": "string"
                  },
                  "nodeVersion": {
                    "type": "string"
                  },
                  "processId": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error name"
          },
          "message": {
            "type": "string",
            "description": "Descriptive error message"
          }
        }
      }
    }
  }
}
