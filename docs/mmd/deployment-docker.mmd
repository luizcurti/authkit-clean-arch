flowchart LR
    subgraph Host["Docker host"]
        subgraph Network["authkit-network (bridge)"]
            Migrate["migrate container\none-shot: typeorm migration:run"]
            App["app container\nnode:24-alpine\nport 8080"]
            Postgres["postgres container\npostgres:15-alpine\nport 5432"]
            S3Mock["s3mock container\nS3-compatible emulator, port 9090"]
            PgAdmin["pgadmin container\nprofile: tools, port 8081"]
        end
        Volume[(postgres_data volume)]
        PgVolume[(pgadmin_data volume)]
    end

    Client[HTTP Client / Browser] -- "8080:8080" --> App
    Admin[DBA] -- "8081:80" --> PgAdmin
    Migrate -- "DDL, then exits" --> Postgres
    Migrate -. "completed successfully" .-> App
    App -- "SQL over 5432" --> Postgres
    App -- "S3 API (path-style)" --> S3Mock
    Client -- "GET picture, 9090" --> S3Mock
    PgAdmin -- "SQL over 5432" --> Postgres
    Postgres --> Volume
    PgAdmin --> PgVolume

    FB[Facebook Graph API]
    App -. HTTPS .-> FB
